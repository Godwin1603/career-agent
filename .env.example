# .env.example
# Production template
# 
# Note: In production, sensitive variables (DATABASE_URL, REDIS_URL, TELEGRAM_*, GMAIL_*)
# should NOT be defined here. They are injected natively into the Cloud Run container
# environment variables from Google Secret Manager during deployment.

# ==========================================================
# Google Cloud Platform (Non-sensitive)
# ==========================================================
GCP_PROJECT_ID=career-agent-503617
GCS_BUCKET_NAME=career-agent-data-career-agent-503617
CLOUD_TASKS_LOCATION=us-central1

# Set automatically during deployment by the 09_cloud_run.sh script
CLOUD_RUN_SERVICE_URL=

# ==========================================================
# Cloud Tasks Queue Names
# ==========================================================
CLOUD_TASKS_QUEUE_JOB_ENRICHMENT=job-enrichment-q
CLOUD_TASKS_QUEUE_PORTAL_APPLICATION=portal-application-q
CLOUD_TASKS_QUEUE_FORM_APPLICATION=form-application-q
CLOUD_TASKS_QUEUE_EMAIL_APPLICATION=email-application-q
CLOUD_TASKS_QUEUE_NOTIFICATION=notification-q

# ==========================================================
# AI — Gemini
# ==========================================================
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ==========================================================
# Application Behavior Tuning
# ==========================================================
RELEVANCE_THRESHOLD=65
MAX_PORTAL_APPS_PER_DAY=5
JOB_EXPIRY_DAYS=14
STALE_APPLICATION_WINDOW_MINUTES=90
CLEANUP_RUN_INTERVAL_MINUTES=30
BROWSER_TIMEOUT_MS=30000

# ==========================================================
# Secret References (DO NOT FILL IN PRODUCTION ENV)
# ==========================================================
# DATABASE_URL=
# REDIS_URL=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=
# TELEGRAM_CHANNEL_ID=
# TELEGRAM_NOTIFY_CHAT_ID=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# GMAIL_SENDER_ADDRESS=
